# Production (Vercel): leave empty — vercel.json rewrites /api → Railway Node backend
# VITE_API_BASE=
# Railway Node API (reference only — do NOT set in Vercel prod build):
# https://eh-arogya-api-production.up.railway.app
VITE_APP_NAME=E.H. Arogya Sutra

# Dev: use Vite proxy → Node :5000 (NOT eh_api.py :8005)
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_PORT=5178
# Never set VITE_API_BASE to :8005 — Python has no /api/summary/eh-api route
