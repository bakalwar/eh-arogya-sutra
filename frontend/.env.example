# Production API URL (Railway backend — set after Railway deploy)
VITE_API_BASE=https://your-backend.railway.app
# Alias (either works):
# VITE_API_URL=https://your-backend.railway.app
VITE_APP_NAME=E.H. Arogya Sutra

# Local network — replace LAPTOP-IP with your WiFi IP (e.g. 192.168.1.5)
# VITE_API_URL=http://192.168.1.5:3001

# Dev proxy target (when using Vite dev server)
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_PORT=5178
