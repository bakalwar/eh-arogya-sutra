# Vite dev — API via proxy to Node :5000 (NOT eh_api.py :8005 — no /api/summary routes on Python)
# EH API summary: up to 10 min; must match vite.config.js VITE_API_PROXY_TIMEOUT_MS
VITE_API_EXPERT_CLINICAL_TIMEOUT_MS=600000
VITE_API_LONG_TIMEOUT_MS=600000
VITE_API_TIMEOUT=600000
VITE_SUMMARY_TIMEOUT=600000
VITE_API_PROXY_TIMEOUT_MS=780000
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_APP_ENV=local
