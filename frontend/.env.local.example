# Copy to frontend/.env.local (gitignored) for strict local overrides.
# Default dev values are in frontend/.env.development (committed).

VITE_APP_ENV=local
VITE_APP_NAME=E.H. Arogya Sutra

# Vite dev server (must match scripts/dev-local.js)
VITE_PORT=5178
# Set by npm run dev:local — shown in green LOCAL DEV banner for phone testing
# VITE_MOBILE_DEV_URL=http://192.168.x.x:5178

# Node backend — Vite proxy target (NOT production Railway)
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
# Leave empty in dev — browser uses same-origin /api via Vite proxy
VITE_API_BASE=
VITE_API_URL=

# Python EH API — direct /api/v3/* via Vite proxy (optional; most routes go via Node :5000)
VITE_PYTHON_API_URL=http://127.0.0.1:8005

# Long-running summary / expert timeouts (ms)
VITE_API_EXPERT_CLINICAL_TIMEOUT_MS=600000
VITE_API_LONG_TIMEOUT_MS=600000
VITE_API_TIMEOUT=600000
VITE_SUMMARY_TIMEOUT=600000
VITE_API_PROXY_TIMEOUT_MS=780000

# Never set in local dev:
# VITE_RAILWAY_API_URL=
