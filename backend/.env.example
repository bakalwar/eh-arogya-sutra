# ═══════════════════════════════════════════════════════════
# E.H. Arogya Sutra — Railway + Supabase Production Template
# Copy values into Railway → Variables (never commit real secrets)
# ═══════════════════════════════════════════════════════════

# ── Supabase PostgreSQL ──
# Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
POSTGRES_SSL=1

# ── App ──
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://eh-arogya-sutra.vercel.app
CORS_ORIGIN=https://eh-arogya-sutra.vercel.app

# ── JWT (generate strong random strings) ──
JWT_SECRET=change-me-long-random-secret
JWT_REFRESH_SECRET=change-me-long-random-refresh-secret
JWT_ACCESS_EXPIRE=15m

# ── Security ──
DISABLE_HMAC=1
PG_AUTO_BOOTSTRAP=1

# ── SMS OTP (required for login) ──
# Get API key: https://www.fast2sms.com/
FAST2SMS_KEY=your-fast2sms-api-key

# ── Email (optional — OTP uses SMS only) ──
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM=E.H. Arogya Sutra

# ── Demo doctor (optional — for testing) ──
DEMO_DOCTOR_MOBILE=9876543210
DEMO_DOCTOR_PASSWORD=demo123
DEMO_DOCTOR_EMAIL=your-email@gmail.com

# ── Admin ──
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=admin123

# ── EH Python API (optional — Node fallback works if offline) ──
EH_API_URL=
EH_NODE_SINGLE_ENGINE=0

# ── Redis (optional — skip on free tier) ──
# REDIS_URL=

# ── SMS (optional) ──
# OTP login uses SMS only — set FAST2SMS_KEY on Railway
FAST2SMS_KEY=
