# ═══════════════════════════════════════════════════════════
# E.H. Arogya Sutra — Production Template
# Copy values into Railway → Variables (never commit real secrets)
# ═══════════════════════════════════════════════════════════

# ── PostgreSQL ──
DATABASE_URL=postgresql://postgres:PASSWORD@host:5432/railway
POSTGRES_SSL=1

# ── App ──
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://eh-arogya-sutra.vercel.app
CORS_ORIGIN=https://eh-arogya-sutra.vercel.app
CLINIC_PHONE=9098791989

# ── JWT (generate strong random strings) ──
JWT_SECRET=change-me-long-random-secret
JWT_REFRESH_SECRET=change-me-long-random-refresh-secret
JWT_ACCESS_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d
JWT_REFRESH_DAYS=7

# ── Auth lockout (optional overrides) ──
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MS=900000

# ── Security ──
DISABLE_HMAC=1
PG_AUTO_BOOTSTRAP=1

# ── Demo doctor (local / testing) ──
DEMO_DOCTOR_MOBILE=9876543210
DEMO_DOCTOR_PASSWORD=demo123
DEMO_DOCTOR_NAME=Demo Doctor

# ── Admin ──
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=admin123

# ── EH Python API (eh_api.py — 9 Rule Engines + summary_engine.py) ──
# Local: http://127.0.0.1:8005  |  Railway: Python service public URL
EH_API_URL=http://127.0.0.1:8005
EH_EXPERT_ENGINE_URL=http://127.0.0.1:8005
EH_API_KEY=EH_TEST_KEY_2026
# Node rule-engine fallback OFF by default — EH API only
EH_EXPERT_FALLBACK_NODE=0
EH_NODE_SINGLE_ENGINE=0

# ── Redis (optional — skip on free tier) ──
# REDIS_URL=
