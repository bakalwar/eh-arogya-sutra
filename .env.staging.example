# =============================================================================
# STAGING — copy to Railway / staging secrets (NEVER use production DATABASE_URL)
# =============================================================================
APP_ENV=staging
EH_DEPLOY_ENV=staging
NODE_ENV=production
PORT=5000

# Staging Postgres only (Supabase staging project or Railway Postgres plugin)
DATABASE_URL=postgresql://USER:PASS@HOST:5432/eh_arogya_staging?sslmode=require

# CORS — Vercel staging domain
CORS_ORIGIN=https://staging.arogyasutra.com,http://localhost:5173

# Hybrid Ollama on your PC — ngrok / Tailscale URL (see docs/STAGING-DEPLOYMENT.md)
EH_STAGING_HYBRID_OLLAMA=1
EH_SUMMARY_LOCAL_ONLY=0
OLLAMA_URL=https://YOUR-ID.ngrok-free.app
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ENABLED=1

# Fast high-density summary (~400 words, 7 sections)
EH_SUMMARY_MODE=ollama-book
EH_SUMMARY_DENSE_MODE=1
EH_SUMMARY_TARGET_WORDS=400
EH_SUMMARY_MIN_WORDS_OLLAMA=220
EH_SUMMARY_BOOK_RAG_CHARS=6000
OLLAMA_EXPERT_NUM_PREDICT=1400
OLLAMA_NUM_CTX=4096
OLLAMA_EXPERT_CLINICAL_TIMEOUT_MS=600000
EH_OLLAMA_DOCTOR_TIMEOUT_MS=600000
HTTP_SERVER_TIMEOUT_MS=720000

# Expert engine — local tunnel or disable OCR merge on cloud
EH_EXPERT_ENGINE_URL=http://127.0.0.1:8001
EH_EXPERT_OCR=0

# Staging demo login
STAGING_DOCTOR_MOBILE=9876543210
STAGING_DOCTOR_PASSWORD=demo123
DEMO_DOCTOR_MOBILE=9876543210
DEMO_DOCTOR_PASSWORD=demo123

# Payments — sandbox only on staging
# PHONEPE_ENV=sandbox

JWT_SECRET=change-me-staging-only-long-random-string
