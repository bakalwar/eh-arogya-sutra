# ═══════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT MODE — copy this file to `.env` at repo root
# Strict local only: no cloud deploy until you change EH_LOCAL_DEV=0
# ═══════════════════════════════════════════════════════════════

EH_LOCAL_DEV=1
APP_ENV=local
NODE_ENV=development

# Node Express API (frontend proxies /api → here)
PORT=5000
CLIENT_URL=http://127.0.0.1:5178
EH_VITE_DEV_URL=http://127.0.0.1:5178

# Python EH API (eh_api.py — npm run expert-engine)
EH_PYTHON_API_URL=http://127.0.0.1:8005
EH_API_URL=http://127.0.0.1:8005
EH_EXPERT_ENGINE_URL=http://127.0.0.1:8005
EH_API_OPEN=1

# CORS — Vite :5178 + Next.js :3001 only (add LAN IP if needed)
CORS_ORIGIN=http://localhost:5178,http://127.0.0.1:5178,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5000,http://127.0.0.1:5000

# Ollama (local only)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_ENABLED=1

# PostgreSQL — fill for full auth/patients (optional for UI-only testing)
# DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5432/eh_arogyaa_sutra_db?sslmode=disable

# Demo login (after npm run seed:postgres)
# DEMO_DOCTOR_MOBILE=9876543210
# DEMO_DOCTOR_PASSWORD=demo123
