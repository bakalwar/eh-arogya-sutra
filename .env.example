# Environment Configuration for E.H. Arogya Sutra App
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# PostgreSQL (required) — `auth_failed` = wrong user/password, wrong DB name, or SSL mismatch.
#
# Use the SAME login as pgAdmin (Server → Properties, or the user you connect with).
# Local Windows/macOS: append `?sslmode=disable` unless you use SSL.
#
# Option A — one line (password with special chars must be URL-encoded: @ → %40, # → %23):
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/eh_arogyaa_sutra_db?sslmode=disable
#
# Option B — split (password auto-encoded; leave DATABASE_URL empty):
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=YOUR_PASSWORD
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=eh_arogyaa_sutra_db
#
DATABASE_URL=
# Then: npm run seed:postgres
# SEQUELIZE_LOGGING=1
# POSTGRES_SSL=1
# POSTGRES_SSL_REJECT_UNAUTHORIZED=0
# PostgreSQL pool (Sequelize — tune for load; use PgBouncer in production at 100k+ doctors)
# PG_POOL_MAX=30
# PG_POOL_MIN=2
# PG_POOL_ACQUIRE_MS=60000
# PG_POOL_IDLE_MS=10000

# Clinic branding (reports / prescriptions / PDFs)
# CLINIC_NAME=E.H. AROGYA SUTRA
# CLINIC_PHONE=9098791989

# Ollama LLM (EH Hindi summaries — optional; fallback = newSummaryEngine)
# Install: https://ollama.com/download then: ollama pull llama3.2:3b
# Use 127.0.0.1 (not localhost) on Windows — avoids IPv6 ::1 vs Ollama on 127.0.0.1 "fetch failed".
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ENABLED=1
OLLAMA_SUMMARY_TIMEOUT_MS=120000
# ollama pull llama3.2:3b

# EH Expert Engine (Python FastAPI — npm run expert-engine)
EH_EXPERT_ENGINE_URL=http://127.0.0.1:8001
EH_EXPERT_TIMEOUT_MS=120000
# Set 0 to skip Expert OCR merge on report upload (uses Node tesseract.js only)
EH_EXPERT_OCR=1

# EH Doctor — जब JSON rule lock न मिले तो Ollama चिकित्सक की तरह potency/विद्युत तय करे (फिर 7-खंड सार)
EH_OLLAMA_DOCTOR=1
EH_OLLAMA_DOCTOR_MODEL=llama3.2:3b
EH_OLLAMA_DOCTOR_TIMEOUT_MS=600000
# Ollama: 90s try then rule-engine summary (avoids 504 "समय सीमा पार")
EH_OLLAMA_MAX_WAIT_MS=600000
EH_SUMMARY_SKIP_VECTOR=1
# Step 3.4 — 7-section clinical summary (Smart Search result page)
OLLAMA_EXPERT_CLINICAL_TIMEOUT_MS=600000
HTTP_SERVER_TIMEOUT_MS=720000
# EH_SUMMARY_SKIP_OLLAMA=1
# Book = Source of Truth for formulas (not generic S10+C14)
# EH_USE_SOURCE_OF_TRUTH=1
# Rule engine v4 (doctor vitals/symptoms/labs) — default ON; book JSON only if =1
# EH_USE_MEDICINE_KNOWLEDGE=0
# 38Med JSON KB (medicine_knowledge_base.json) — default ON; rule-only: EH_USE_KNOWLEDGE_BASE=0
# EH_USE_KNOWLEDGE_BASE=1
# npm run build:medicine-kb
# npm run map:book — book → medicine_knowledge_base.json (CPU: use 10min timeout)
# EH_MAP_TIMEOUT_MS=600000
# EH_MAP_RETRIES=2
# EH_MAP_BOOK_CHARS=3200
# Analyze without Python expert (recommended dev) — avoids 502 when port 8001 off
EH_NODE_SINGLE_ENGINE=0
# If Python expert used: fallback to Node when 8001 down (default ON)
# EH_EXPERT_FALLBACK_NODE=1
# Concise summary (~500 words / ~600 tokens) — fewer timeouts on CPU
EH_SUMMARY_DENSE_MODE=1
EH_SUMMARY_TARGET_WORDS=500
EH_SUMMARY_MIN_WORDS_OLLAMA=100
EH_SUMMARY_BOOK_RAG_CHARS=1600
OLLAMA_EXPERT_NUM_PREDICT=600
OLLAMA_NUM_CTX=4096
OLLAMA_EXPERT_SUMMARY_TARGET_WORDS=500
OLLAMA_EXPERT_MIN_WORDS=180
# Frontend (frontend/.env.development): VITE_API_EXPERT_CLINICAL_TIMEOUT_MS=600000
# OLLAMA_EXPERT_TEMPERATURE=0.15

# Tesseract OCR — report scan (Python Expert + optional Node fallback)
# Windows one-shot: npm run tesseract:hin
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_DIR=eh-expert-engine/tessdata  (hin.traineddata — not in git; script downloads)
# TESSERACT_LANG=hin+eng
# PRIMARY: Ollama reads book ingest + dynamicEhRules — per-patient medicines (no S10+A3+F1 template)
EH_SUMMARY_MODE=ollama-book
EH_OLLAMA_DOCTOR=1
EH_OLLAMA_DOCTOR_TEMPERATURE=0.28
# rule-only = पुराना टेम्पलेट (बंद रखें)
# EH_SUMMARY_MODE=rule-only
# Ollama fail पर rule-engine सार (502 नहीं) — default ON; बंद: EH_SUMMARY_TEMPLATE_ON_OLLAMA_FAIL=0
# EH_ALLOW_TEMPLATE_FALLBACK=1
# SCISPACY_MODEL=en_core_sci_sm

# --- Clinical privacy (mandated: clinic local only) ---
EH_SUMMARY_LOCAL_ONLY=1
OLLAMA_URL=http://127.0.0.1:11434
BOOK_RAG_MAX_CHARS=28000
BOOK_RAG_TOP_K=10
# Dr. page ingest: POST /api/book-rag/ingest-page { page_number, text } → book/extracted/doctor_supplied/
# Batch folder: backend/book/extracted/incoming_batch/page_NNNN.txt → npm run ingest:book-batch
# Status: npm run ingest:book-status
#
# PHASE 1 (now): ingest all chapters — keep extraction LOCKED:
EH_RULE_EXTRACT_ALLOW=0
# PHASE 2 (after full book): set EH_RULE_EXTRACT_ALLOW=1 then run generate-rules once
# POST /api/book-rag/generate-rules  { query?, text?, append? }
# npm run extract:eh-rules -- "पूर्ण पुस्तक विद्युत पोटेंसी"
EH_RULE_EXTRACT_BATCH_CHARS=4500
EH_RULE_EXTRACT_CHUNKS_PER_BATCH=2
EH_RULE_EXTRACT_VECTOR_TOP_K=20
EH_RULE_EXTRACT_MODEL=qwen2.5-coder:1.5b
EH_RULE_EXTRACT_TIMEOUT_MS=240000
EH_RULE_EXTRACT_NUM_PREDICT=1024
EH_RULE_EXTRACT_RULES_PER_BATCH_MAX=6
# EH_AUTO_EXTRACT_RULES=1

# LibreTranslate (summary languages — free, self-hosted)
# Windows (Python was missing — use npm, NOT raw pip):
#   npm run libretranslate:install
#   npm run libretranslate:start
# Then in .env:
LIBRETRANSLATE_URL=http://127.0.0.1:5001
# If local server not running, app tries public mirror as backup (dev only):
# LIBRETRANSLATE_USE_PUBLIC=1
# Optional API key (libretranslate.com):
# LIBRETRANSLATE_API_KEY=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRE=30d

# Super Admin (Master Control — /super-admin/login)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=superSecurePass2026
SUPER_ADMIN_SECRET=eh_arogya_master_key
SUPER_ADMIN_IP_WHITELIST=127.0.0.1,::1,::ffff:127.0.0.1
SUPER_ADMIN_MOBILE=9000000001

# Demo doctor login (after npm run seed)
DEMO_DOCTOR_MOBILE=9876543210
DEMO_DOCTOR_PASSWORD=demo123
DEMO_DOCTOR_NAME=Demo Doctor
# Demo mobile always seeds as doctor (clinic dashboard). Platform admin uses a separate account.
DEMO_DOCTOR_ROLE=doctor
DEMO_DOCTOR_EMAIL=your-gmail@gmail.com

# Gmail OTP (preferred) — App Password from Google Account → Security
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=E.H. Arogya Sutra
SHOW_DEV_OTP=1

# JWT — access 15 min, refresh 7 days (stored in refresh_tokens table)
JWT_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRE=7d
JWT_REFRESH_DAYS=7

# Email OTP (Nodemailer + Gmail App Password) — if empty, OTP prints in server console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com

AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCK_MINUTES=30
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MS=900000
AUTH_OTP_MAX_ATTEMPTS=5

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# OCR API (for report analysis)
OCR_API_KEY=your-ocr-api-key
OCR_API_URL=https://api.ocr.space/parse/image

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Login route only: max attempts per IP per window (L6)
AUTH_LOGIN_WINDOW_MS=900000
AUTH_LOGIN_MAX_ATTEMPTS=5

# Admin Configuration
ADMIN_EMAIL=admin@eh-arogya-sutra.com
ADMIN_PASSWORD=change-this-admin-password

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Monitoring
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# Redis (for caching - optional)
REDIS_URL=redis://localhost:6379

# Cloud Storage (AWS S3 - optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=eh-arogya-bucket

# Analytics
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID

# Support
SUPPORT_EMAIL=support@eh-arogya-sutra.com
SUPPORT_PHONE=+91-9876543210