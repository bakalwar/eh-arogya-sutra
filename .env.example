# E.H. AROGYA SUTRA 2 — copy to .env.local (never commit secrets)
EHAS2_NODE_ENV=development
EHAS2_API_PUBLIC_URL=http://localhost:4100
EHAS2_WEB_PUBLIC_URL=http://localhost:4101
EHAS2_LOG_LEVEL=info

# PostgreSQL persistence (Phase 3A) — placeholders only; do not commit real credentials
# Provide a libpq-style PostgreSQL connection URL via local env (never commit the live value)
EHAS2_DATABASE_URL=
EHAS2_DATABASE_POOL_MIN=0
EHAS2_DATABASE_POOL_MAX=10
EHAS2_DATABASE_SSL_MODE=disable
EHAS2_DATABASE_STATEMENT_TIMEOUT_MS=12000
