{
  "installCommand": "npm install && npm install --prefix frontend",
  "buildCommand": "npm run build:web",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://eh-arogya-api-production.up.railway.app/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://eh-arogya-api-production.up.railway.app/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://eh-arogya-api-production.up.railway.app/uploads/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
